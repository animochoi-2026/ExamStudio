{
  "rules": [
    {
      "allowed": {
        "origins": ["https://examstudio-shared-bank.pages.dev", "http://localhost:4173", "http://127.0.0.1:4173", "https://r2-staging.examstudio-shared-bank.pages.dev"],
        "methods": ["GET", "HEAD"],
        "headers": ["Range"]
      },
      "exposeHeaders": ["Content-Length", "Content-Type", "ETag", "Content-Range", "Accept-Ranges"],
      "maxAgeSeconds": 300
    },
    {
      "allowed": {
        "origins": ["https://examstudio-shared-bank.pages.dev"],
        "methods": ["PUT"],
        "headers": ["Content-Type", "Cache-Control", "x-amz-meta-sha256"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 300
    }
  ]
}
