# Private local file or protected GitHub Environment secrets. Never use frontend prefixes.
SOURCE_MODE=rest
SOURCE_REFERENCE_MODE=rest
# Select management when service_role lacks bank_entries SELECT; uses the
# existing project-scoped Database Read SUPABASE_ACCESS_TOKEN, never changes grants.
SOURCE_BUCKET=question-bank
SUPABASE_URL=
SUPABASE_READ_KEY=
# REST source needs a server secret/service_role with complete list/read access.
# S3 also needs DB reference credentials and READ_KEY for the actual freeze RPC.
# Reuse an existing safe credential; do not mint a broader key without review.
# Or use existing S3 credentials, with SOURCE_MODE=s3:
SOURCE_S3_ENDPOINT=
SOURCE_S3_REGION=
SOURCE_S3_ACCESS_KEY_ID=
SOURCE_S3_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Exactly 64 hex characters, generated privately; AES-256-GCM journal key.
MIGRATION_STATE_KEY=
# Stable job identity, reuse unchanged when resuming.
MIGRATION_JOB=night-cutover
# Copy/verify require the documented external write freeze and explicit acknowledgement.
MIGRATION_WRITES_FROZEN=
# Set only for a separately approved reverse copy after cutover.
SUPABASE_RESTORE_KEY=

# Optional read-only Management API metadata/source probe, not a Storage transfer key.
SUPABASE_ACCESS_TOKEN=
# Separate runtime key, local DPAPI only until deployment approval.
R2_RUNTIME_ACCESS_KEY_ID=
R2_RUNTIME_SECRET_ACCESS_KEY=
